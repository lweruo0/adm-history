parameters:
    level: 5
    paths:
        - classes
        - tests
        - index.php
        - mitgliedsarten.php
    # Admidio ist zur Analyse nicht installiert; die verwendeten Klassen, Funktionen und
    # Konstanten sind in stubs/admidio.php als Signaturen hinterlegt.
    scanFiles:
        - stubs/admidio.php
    excludePaths:
        - stubs
        - vendor
