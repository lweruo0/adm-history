{
    "name": "lweruo0/adm-history",
    "description": "Admidio-5-Plugin: Mitglieder-Historie mit Mitgliedsart je Jahr und Wechsel für aktuelles Jahr und Folgejahr",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "AdmHistory\\": "classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdmHistory\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "@php tools/lint.php",
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "check": [
            "@lint",
            "@test",
            "@stan"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
